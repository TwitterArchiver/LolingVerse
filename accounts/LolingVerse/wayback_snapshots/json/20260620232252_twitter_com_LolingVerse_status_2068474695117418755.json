        "note_tweet": {
          "entities": {
            "urls": [
              {
                "display_url": "blog.kawaiis.in/posts/%E8%BF%9…",
                "end": 770,
                "expanded_url": "https://blog.kawaiis.in/posts/%E8%BF%99%E8%8C%B6%E9%87%8C%E5%B9%B6%E4%B8%8D%E7%A6%81%E7%83%9F/",
                "start": 747,
